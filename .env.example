# Copie para .env e preencha somente no seu computador. Nunca envie o token no chat.
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=36953879
CLICKUP_PARTNER_ENABLED=true
# Teste privado: somente Welington recebe atribuições. Vazio libera os IDs dos modelos.
CLICKUP_PARTNER_ALLOWED_ASSIGNEE_IDS=61029153
# Opcional: limitar o teste a IDs internos separados por virgula.
CLICKUP_PARTNER_ALLOWED_PARENT_IDS=
# Vazio: o worker memoriza no banco o instante do primeiro inicio.
CLICKUP_PARTNER_START_AFTER=
# Para executar Python fora do container; compose usa a rede interna do Docker.
PARTNER_DATABASE_URL=postgresql://clickup_local:local_development_only@127.0.0.1:55432/clickup_partners
